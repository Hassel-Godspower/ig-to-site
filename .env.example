# Groq — free-tier LLM API, used to generate the site's HTML/CSS/JS
GROQ_API_KEY=gsk_...

# Stripe — payment + webhook verification. Set STRIPE_PRICE_ID to a $9
# one-time Price you create in the Stripe dashboard (Products → Add product).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# Supabase — free-tier Postgres for job records, plus a Storage bucket
# named "sites" (create it in the Supabase dashboard, private) that holds
# each job's generated files until payment. Nothing in this bucket is
# public — the preview page reads it through your own API route.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# GitHub — a personal access token (classic) with the "repo" scope, under
# the account you want customer site repos created in. Only used once, at
# payment time: creates a new private repo and pushes that job's files
# into it. Nothing is created in your GitHub account for a free preview
# that never converts.
GITHUB_TOKEN=ghp_...

# This app's own public URL (for Stripe redirect targets)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
