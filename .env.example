# Groq — free-tier LLM API, used to generate the site's HTML/CSS/JS
GROQ_API_KEY=gsk_...

# Paystack — payment + webhook verification (same secret key does both:
# it authorizes API calls, and signs webhook payloads via HMAC-SHA512).
# PAYSTACK_AMOUNT is in the currency's smallest unit — e.g. 900000 for
# ₦9,000 NGN (kobo), or 900 for $9.00 if your account has USD enabled.
# PAYSTACK_CURRENCY defaults to NGN if unset; only set it to something else
# if that currency is actually enabled on your Paystack account.
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_AMOUNT=900000
PAYSTACK_CURRENCY=NGN

# Supabase — free-tier Postgres for job records, plus a Storage bucket
# named "sites" (create it in the Supabase dashboard, private) that holds
# each job's generated files until payment. Nothing in this bucket is
# public — the preview page reads it through your own API route.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# GitHub — a personal access token (classic) with the "repo" scope, under
# the account you want customer site repos created in. Only used once, at
# payment time: creates a new private repo and pushes that job's files
# into it. Nothing is created in your GitHub account for a free preview
# that never converts.
GITHUB_TOKEN=ghp_...

# This app's own public URL (for Paystack's callback_url)
BASE_URL=http://localhost:3000
