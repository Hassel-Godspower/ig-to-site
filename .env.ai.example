# ── Gòke AI provider router ────────────────────────────────
# Primary (keep your existing key)
GROQ_API_KEY=gsk_...
# Optional model override (default: openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b

# Fallback 1 — Google AI Studio free tier
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Fallback 2 — Cerebras (OpenAI-compatible, free tier available)
# https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# CEREBRAS_MODEL=llama-3.3-70b

# Fallback 3 — OpenRouter (many free models)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Order (comma-separated). Only keys that are set are tried.
# AI_PROVIDER_ORDER=groq,gemini,cerebras,openrouter

# Log provider switches in server logs
# AI_ROUTER_LOG=1
